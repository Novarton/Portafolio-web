---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Mensaje Enviado">
  <main class="text-center py-20 px-4">
    <div class="mb-6 inline-flex items-center justify-center w-16 h-16 rounded-full bg-cyan-900/30 text-cyan-400 border-2 border-cyan-400">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </div>

    <h1 class="text-4xl font-bold text-white">¡Gracias, Adrián recibió tu mensaje!</h1>
    <p class="text-gray-300 mt-4 max-w-md mx-auto">Te responderé lo antes posible para platicar sobre las estancias.</p>
    
    <a href="/" class="mt-8 inline-block text-cyan-400 border border-cyan-400 hover:bg-cyan-400 hover:text-black transition-colors px-6 py-2 rounded font-medium">
      Volver al inicio
    </a>
  </main>
</Layout>